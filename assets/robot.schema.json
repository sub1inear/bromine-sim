{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "bromine-sim robot",
    "description": "Robot description loaded by bromine-sim.",
    "type": "object",
    "required": ["version", "width", "height", "mass", "devices"],
    "additionalProperties": false,
    "properties": {
        "$schema": { "type": "string" },
        "version": {
            "description": "Format version. Must be 1.",
            "const": 1
        },
        "width": {
            "description": "Chassis width in inches.",
            "type": "number",
            "exclusiveMinimum": 0
        },
        "height": {
            "description": "Chassis height in inches.",
            "type": "number",
            "exclusiveMinimum": 0
        },
        "mass": {
            "description": "Robot mass in pounds.",
            "type": "number",
            "exclusiveMinimum": 0
        },
        "devices": {
            "type": "array",
            "items": {
                "oneOf": [
                    { "$ref": "#/definitions/motor" },
                    { "$ref": "#/definitions/wheel" },
                    { "$ref": "#/definitions/imu" },
                    { "$ref": "#/definitions/distance" }
                ]
            }
        }
    },
    "definitions": {
        "port": {
            "description": "V5 smart port.",
            "type": "integer",
            "minimum": 1,
            "maximum": 21
        },
        "x": {
            "description": "Offset from the robot center in inches. Positive is right.",
            "type": "number"
        },
        "y": {
            "description": "Offset from the robot center in inches. Positive is up.",
            "type": "number"
        },
        "angle": {
            "description": "Angle in degrees. 0 is up, positive is clockwise.",
            "type": "number"
        },
        "motor": {
            "type": "object",
            "required": [
                "type",
                "port",
                "id",
                "role",
                "power",
                "ratio",
                "reversed",
                "x",
                "y",
                "angle"
            ],
            "additionalProperties": false,
            "properties": {
                "type": { "const": "motor" },
                "port": { "$ref": "#/definitions/port" },
                "id": {
                    "description": "Links the motor to wheels with the same id.",
                    "type": "integer",
                    "minimum": 0
                },
                "role": {
                    "type": "string",
                    "enum": ["input", "output", "drive"]
                },
                "power": {
                    "description": "`full` is 11W, `half` is 5.5W.",
                    "type": "string",
                    "enum": ["full", "half"]
                },
                "gearset": {
                    "description": "Cartridge. Only for `full` motors.",
                    "type": "string",
                    "enum": ["red", "green", "blue"]
                },
                "ratio": {
                    "description": "External gear ratio. Non-zero.",
                    "type": "number",
                    "not": { "const": 0 }
                },
                "reversed": { "type": "boolean" },
                "x": { "$ref": "#/definitions/x" },
                "y": { "$ref": "#/definitions/y" },
                "angle": { "$ref": "#/definitions/angle" }
            },
            "if": { "properties": { "power": { "const": "full" } } },
            "then": { "required": ["gearset"] },
            "else": { "not": { "required": ["gearset"] } }
        },
        "wheel": {
            "type": "object",
            "required": ["type", "subtype", "id", "x", "y", "angle", "width", "diameter"],
            "additionalProperties": false,
            "properties": {
                "type": { "const": "wheel" },
                "subtype": {
                    "type": "string",
                    "enum": ["omni", "traction", "flex"]
                },
                "id": {
                    "description": "Links the wheel to motors with the same id.",
                    "type": "integer",
                    "minimum": 0
                },
                "x": { "$ref": "#/definitions/x" },
                "y": { "$ref": "#/definitions/y" },
                "angle": { "$ref": "#/definitions/angle" },
                "width": {
                    "description": "Wheel width, in inches.",
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "diameter": {
                    "description": "Wheel diameter, in inches.",
                    "type": "number",
                    "exclusiveMinimum": 0
                }
            }
        },
        "imu": {
            "type": "object",
            "required": ["type", "port", "x", "y", "angle"],
            "additionalProperties": false,
            "properties": {
                "type": { "const": "imu" },
                "port": { "$ref": "#/definitions/port" },
                "x": { "$ref": "#/definitions/x" },
                "y": { "$ref": "#/definitions/y" },
                "angle": { "$ref": "#/definitions/angle" }
            }
        },
        "distance": {
            "type": "object",
            "required": ["type", "port", "x", "y", "angle"],
            "additionalProperties": false,
            "properties": {
                "type": { "const": "distance" },
                "port": { "$ref": "#/definitions/port" },
                "x": { "$ref": "#/definitions/x" },
                "y": { "$ref": "#/definitions/y" },
                "angle": { "$ref": "#/definitions/angle" }
            }
        }
    }
}
