{
  "name": "bromine-sim",
  "displayName": "Bromine Sim",
  "description": "Run and debug PROS projects in a VEX V5 simulator",
  "version": "0.0.1",
  "publisher": "sublinear",
  "repository": {
    "type": "git",
    "url": "https://github.com/sub1inear/bromine-sim.git",
    "directory": "extension"
  },
  "license": "MIT",
  "icon": "assets/icon.png",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/project.pros"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "bromine-sim.run",
        "title": "Run Sim",
        "category": "Bromine Sim",
        "enablement": "bromine-sim.hasProject"
      },
      {
        "command": "bromine-sim.debug",
        "title": "Debug Sim",
        "category": "Bromine Sim",
        "enablement": "bromine-sim.hasProject"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "bromine-sim.run",
          "when": "bromine-sim.hasProject",
          "group": "navigation@1"
        },
        {
          "command": "bromine-sim.debug",
          "when": "bromine-sim.hasProject",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "bromine-sim.run",
          "when": "bromine-sim.hasProject"
        },
        {
          "command": "bromine-sim.debug",
          "when": "bromine-sim.hasProject"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": "**/robot.json",
        "url": "./schemas/robot.schema.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "prepackage": "node prepare-package.js",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "@types/vscode": "^1.140.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "fflate": "^0.8.3"
  }
}
